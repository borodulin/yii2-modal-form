        "yiisoft/yii2": "^2.0.4"
    },
    "suggest": {
        "yiisoft/yii2-bootstrap": "Bootstrap 3",
        "yiisoft/yii2-bootstrap4": "Bootstrap 4",
        "yiisoft/yii2-bootstrap5": "Bootstrap 5"
    },
    "autoload": {
        "psr-4": {
            "conquer\\modal\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.4.x-dev"
        }
